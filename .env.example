# Copy to .env; never commit .env. Change the password for shared deployments.
POSTGRES_USER=alfahack
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=alfahack
DATABASE_URL=postgresql://alfahack:local-development-only@localhost:55432/alfahack
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
INGEST_API_KEY=
LLM_MODE=offline
# Sending company context off-machine is disabled until explicitly enabled.
LLM_ALLOW_EXTERNAL=false
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Exact provider deployment IDs from the approved hackathon list, supplied by organizers.
LLM_ALLOWED_MODELS=["google/gemma-4-26b-a4b-it","z-ai/glm-5.3-flash","qwen/qwen3.6-35b-a3b","deepseek/deepseek-v4.1-flash","qwen/qwen3-vl-30b-a3b-instruct","moonshotai/kimi-k2.6"]
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_SECONDS=90
SESSION_HOURS=24
