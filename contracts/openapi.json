  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "material_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array",
                "maxItems": 10,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Material Ids"
          },
          "max_events": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Max Events",
            "default": 5
          },
          "max_depth": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Max Depth",
            "default": 3
          },
          "decay": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Decay",
            "default": 0.5
          },
          "min_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Min Score",
            "default": 0.05
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalysisRequest"
      },
      "Article": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 100000,
            "minLength": 20,
            "title": "Body"
          },
          "source_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Source Name"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Source Url"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "title": "Published At"
          },
          "shocks": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Shock"
                },
                "type": "array",
                "maxItems": 13
              },
              {
                "type": "null"
              }
            ],
            "title": "Shocks"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "body",
          "source_name",
          "source_url",
          "published_at"
        ],
        "title": "Article"
      },
      "EvidenceView": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "insight_id": {
            "type": "integer",
            "title": "Insight Id"
          },
          "material_id": {
            "type": "integer",
            "title": "Material Id"
          },
          "section": {
            "type": "string",
            "title": "Section"
          },
          "claim": {
            "type": "string",
            "title": "Claim"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "locator": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Locator"
          },
          "source_title": {
            "type": "string",
            "title": "Source Title"
          },
          "source_ref": {
            "type": "string",
            "title": "Source Ref"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
